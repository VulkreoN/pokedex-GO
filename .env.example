# docker compose settings
POSTGRES_PASSWORD=change-me

# Local / behind your own reverse proxy: leave DOMAIN empty, the app answers on WEB_PORT.
# Public server: set DOMAIN=dex.example.com, WEB_PORT=80, WEB_HTTPS_PORT=443, COOKIE_SECURE=true.
DOMAIN=
WEB_PORT=8080
WEB_HTTPS_PORT=8443
COOKIE_SECURE=false

# Dataset job inside the API: rebuilds from PokeMiners & co every N hours.
DATA_REFRESH_HOURS=6
# Optional, raises GitHub API limits for the asset listing (fine-grained token, public repos read-only).
GITHUB_TOKEN=
# Comma-separated usernames that are always admins (the first account created is admin anyway).
ADMIN_USERNAMES=

# Release signals (see README "Signaux de sortie"): official news locales to follow, empty disables.
NEWS_LOCALES=fr
# PokeMiners Discord announcement channels followed into YOUR server, read by YOUR bot.
# name=channelId pairs; names gm / assets / events drive the parsing.
DISCORD_BOT_TOKEN=
DISCORD_CHANNELS=
FEED_POLL_MINUTES=5
