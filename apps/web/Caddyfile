{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip
	root * /srv

	handle /api/* {
		reverse_proxy api:3000
	}

	# Dataset and assets: cache a bit, service worker revalidates.
	@data path /data/*
	header @data Cache-Control "public, max-age=3600"

	handle {
		try_files {path} /index.html
		file_server
	}
}
