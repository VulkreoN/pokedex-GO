{
	admin off
}

# SITE_ADDRESS is ":80" when DOMAIN is empty (local / behind your own proxy), or the domain itself:
# Caddy then provisions and renews the HTTPS certificate automatically (ports 80/443 must be reachable).
{$SITE_ADDRESS} {
	encode zstd gzip
	root * /srv

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		# Hashed build files never change: cache them for good. Everything else (index.html, sw.js, manifest)
		# is revalidated on each load (a cheap 304 thanks to ETags) so a deploy reaches everyone.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
