{
	admin off
	# Who may tell us the player's IP in X-Forwarded-For: nobody but ourselves when Caddy faces the internet,
	# the cluster's private ranges behind a Kubernetes ingress (TRUSTED_PROXIES=private_ranges).
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# SITE_ADDRESS is ":80" when DOMAIN is empty (local / behind your own proxy), or the domain itself:
# Caddy then provisions and renews the HTTPS certificate automatically (ports 80/443 must be reachable).
{$SITE_ADDRESS} {
	encode zstd gzip
	root * /srv
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	}

	handle /api/* {
		# The API rate-limits on this header: one address, the real client's, never what the client wrote.
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Hashed build files never change: cache them for good, and return 404 (never index.html) if an old chunk is gone.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# Everything else (index.html, sw.js, manifest) is revalidated on each load so a deploy reaches everyone.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
