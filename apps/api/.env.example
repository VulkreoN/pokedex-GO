# Postgres connection (docker compose sets this for you)
DATABASE_URL=postgres://mydex:mydex@localhost:5432/mydex
PORT=3000
# Origin of the web app in dev (Vite). Leave empty in production: Caddy serves both on one origin.
CORS_ORIGIN=http://localhost:5173
# Set to true behind HTTPS
COOKIE_SECURE=false
# Where the dataset job stores its files (default apps/api/.data)
DATA_DIR=
DATA_REFRESH_HOURS=6
ADMIN_USERNAMES=
